// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  credentials Credential[]
  personalEntries  RegistroPersonal[]
  usosHerramientas UsoHerramienta[]
  pinHash String?
}

enum TransactionType {
  INGRESO
  GASTO
}

enum Category {
  // Gastos
  COMIDA
  COMBUSTIBLE
  ALQUILER
  SUPERMERCADO
  OCIO
  GASTOS_SEGUNDO
  PSICOLOGA
  MUTUAL
  EDUCACION
  OTRO
  VACACIONES
  CARRERAS

  // Ingresos
  SUELDO_NETO
  BONO_CATEGORIA
  COMISION_VENTAS
  PREMIOS
  GUARDIAS
  INGRESO_EXTRA
  EMPRENDIMIENTO
  OTRO_INGRESO
}

enum Currency {
  ARS
  USD
}

model Transaction {
  id          Int             @id @default(autoincrement())
  amount      Float
  type        TransactionType
  category    Category
  currency    Currency        @default(ARS)
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id])
  userId      Int
}

model Credential {
  id                Int      @id @default(autoincrement())
  siteName          String
  siteUrl           String?
  username          String
  encryptedPassword String
  iv                String
  authTag           String
  notes             String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
  userId            Int
}

model RegistroPersonal {
  id          Int      @id @default(autoincrement())
  title       String?
  emotions    String?
  description String?
  note        String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
}

model Herramienta {
  id       Int              @id @default(autoincrement())
  order    Int
  name     String
  category String
  purpose  String
  steps    String
  usos     UsoHerramienta[]
}

model UsoHerramienta {
  id            Int         @id @default(autoincrement())
  herramienta   Herramienta @relation(fields: [herramientaId], references: [id])
  herramientaId Int
  usedAt        DateTime    @default(now())
  note          String?
  imageUrl      String?
  user          User        @relation(fields: [userId], references: [id])
  userId        Int
}